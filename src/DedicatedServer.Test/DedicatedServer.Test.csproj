<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <!-- Skip AssemblyExposer MSBuild task — this project has no game DLL deps -->
    <SkipAssemblyExposure>true</SkipAssemblyExposure>
    <!-- No game DLL deps needed: we only compile BootDiagnostics.cs and the
         BuildGameStateDto static method, both of which use only BCL types. -->
  </PropertyGroup>

  <!-- Compile only the two files under test — avoids pulling in the full
       DedicatedServer binary (which would need all game DLLs at runtime). -->
  <ItemGroup>
    <Compile Include="..\DedicatedServer\Game\BootDiagnostics.cs" />
    <Compile Include="..\DedicatedServer\Game\RealWorldState.GameStateDto.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit"                  Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter"      Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedPath)\Newtonsoft.Json.dll" />
  </ItemGroup>
</Project>
